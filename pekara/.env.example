DATABASE_URL="postgresql://pekara:pekara@localhost:5432/pekara"

APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"

# NODE_ENV selects development/test/production. Do not put a local-production
# exception into deployment env files: build:local/start:local opt in in-process.
# APP_ENV="production" is the default and the only deployed production profile.

BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
RATE_LIMIT_HMAC_SECRET="replace-with-at-least-32-random-characters"

BLOB_READ_WRITE_TOKEN=""

SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

SENTRY_ENVIRONMENT="development"
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"

SENTRY_RELEASE=""
NEXT_PUBLIC_SENTRY_RELEASE=""

SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

ADMIN_EMAIL="admin@pekara.local"
ADMIN_NAME="Local Admin"
ADMIN_PASSWORD="replace-with-strong-password"
CONFIRM_PRODUCTION_ADMIN_BOOTSTRAP=""
# Optional integrations are off unless explicitly enabled.
EMAIL_ENABLED="false"
RESEND_API_KEY=""
EMAIL_FROM=""
BLOB_ENABLED="false"
SENTRY_ENABLED="false"
NEXT_PUBLIC_SENTRY_ENABLED="false"
# Local dev ignores forwarded IP headers. Production: Vercel supplies VERCEL=1;
# self-hosted must enforce an ingress proxy and set proxy + its trusted hop count.
TRUSTED_PROXY_MODE="local"
TRUSTED_PROXY_HOPS=""
