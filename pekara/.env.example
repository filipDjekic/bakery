DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pekara
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
RATE_LIMIT_HMAC_SECRET=replace-with-at-least-32-random-characters
BLOB_READ_WRITE_TOKEN=

# Transactional email. Verify the sender domain in Resend before production.
RESEND_API_KEY=
EMAIL_FROM=Pekara <porudzbine@example.com>

# Runtime error reporting. Browser DSN is intentionally public; auth token is not.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=

# Build-only source-map upload credentials. Configure these in CI, never in the browser.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# One-command admin bootstrap only. Remove all four variables immediately after use.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
CONFIRM_PRODUCTION_ADMIN_BOOTSTRAP=
