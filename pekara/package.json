{
  "name": "pekara",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "integration:db:up": "docker compose up -d --wait postgres-test",
    "integration:db:down": "docker compose down",
    "integration:db:migrate": "node --env-file=.env.test --experimental-strip-types tests/helpers/migrate-db.ts",
    "integration:db:reset": "node --env-file=.env.test --conditions=react-server --experimental-strip-types tests/helpers/reset-db.ts",
    "integration:db:prepare": "pnpm run integration:db:migrate && pnpm run integration:db:reset",
    "test:integration": "pnpm run integration:db:prepare && node --env-file=.env.test --conditions=react-server --experimental-strip-types --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:integration:local": "pnpm run integration:db:up && pnpm run test:integration",
    "e2e:server": "node --env-file=.env.test node_modules/next/dist/bin/next dev -p 3000",
    "test:e2e": "pnpm run integration:db:prepare && playwright test",
    "test:e2e:local": "pnpm run integration:db:up && pnpm run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma contract emit",
    "contract:emit": "prisma contract emit",
    "env:check:production": "node --conditions=react-server --experimental-strip-types scripts/check-production-env.ts",
    "db:migrate:production": "node --conditions=react-server --experimental-strip-types scripts/migrate-production.ts",
    "db:verify": "prisma db verify",
    "e2e:seed": "node --env-file=.env.test --conditions=react-server --experimental-strip-types e2e/fixtures/seed.ts",
    "db:seed": "node --env-file=.env src/prisma/seed.ts",
    "admin:create": "node --conditions=react-server --experimental-strip-types scripts/create-admin.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.5",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/orm-postgres": "8.0.0-rc.9",
    "@sentry/nextjs": "^10.75.0",
    "@vercel/blob": "^2.8.0",
    "better-auth": "^1.7.5",
    "dotenv": "^17.4.2",
    "libphonenumber-js": "^1.13.13",
    "lucide-react": "^1.47.0",
    "luxon": "^3.7.2",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "^6.9.5",
    "react-hook-form": "^7.88.0",
    "resend": "^6.28.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/luxon": "^3.7.5",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "8.0.0-rc.13",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24 <25"
  }
}
