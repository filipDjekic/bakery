// use prisma-8
model Category {
  id          Uuid                       @id @default(uuid())
  name        VarChar(80)
  slug        VarChar(100)               @unique
  description VarChar(300)?
  sortOrder   Int                        @default(0)
  isActive    Boolean                    @default(true)

  createdAt   temporal.createdAtString()
  updatedAt   temporal.updatedAtString()

  products    Product[]

  @@index([isActive, sortOrder])
}

model Product {
  id            Uuid                       @id @default(uuid())
  categoryId    Uuid
  name          VarChar(120)
  slug          VarChar(140)               @unique
  description   VarChar(1000)
  priceMinor    Int
  unitLabel     VarChar(40)?
  allergenInfo  VarChar(500)?

  imageUrl      String?
  imagePathname String?
  imageWidth    Int?
  imageHeight   Int?

  isActive      Boolean                    @default(true)
  isAvailable   Boolean                    @default(true)
  sortOrder     Int                        @default(0)

  createdAt     temporal.createdAtString()
  updatedAt     temporal.updatedAtString()

  category      Category                   @relation(fields:[categoryId], references:[id])
  orderItems    OrderItem[]

  @@index([categoryId, isActive, isAvailable, sortOrder])
  @@check(expression: "\"priceMinor\" >= 0", name: "product_price_nonnegative")
  @@check(expression: "(\"imageWidth\" IS NULL OR \"imageWidth\" > 0) AND (\"imageHeight\" IS NULL OR \"imageHeight\" > 0)", name: "product_image_dimensions")

}

enum OrderStatus {
  @@type("pg/text@1")

  NEW
  ACCEPTED
  IN_PREPARATION
  READY
  COMPLETED
  CANCELLED
}

model Order {
  id                 Uuid                       @id @default(uuid())
  orderNumber        VarChar(32)                @unique
  idempotencyKey     Uuid                       @unique
  payloadHash        String
  status             OrderStatus                @default(NEW)

  customerName       VarChar(100)
  customerPhone      VarChar(20)
  customerEmail      VarChar(254)?
  note               VarChar(500)?

  pickupAt           TimestamptzString

  currencyCode       VarChar(3)
  subtotalMinor      Int
  totalMinor         Int

  cancellationReason VarChar(300)?

  createdAt          temporal.createdAtString()
  updatedAt          temporal.updatedAtString()

  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  notifications      OrderNotificationDelivery[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([pickupAt])
  @@check(expression: "\"subtotalMinor\" >= 0 AND \"totalMinor\" >= 0", name: "order_totals_nonnegative")

}

model OrderItem {
  id             Uuid                       @id @default(uuid())
  orderId        Uuid
  productId      Uuid?

  productName    VarChar(120)
  unitPriceMinor Int
  quantity       Int
  subtotalMinor  Int

  createdAt      temporal.createdAtString()

  order          Order                      @relation(fields:[orderId], references:[id], onDelete: Cascade)

  product        Product?                   @relation(fields:[productId], references:[id], onDelete: SetNull)

  @@index([orderId])
  @@check(expression: "\"unitPriceMinor\" >= 0 AND \"quantity\" > 0 AND \"subtotalMinor\" >= 0", name: "order_item_values")
  @@check(expression: "\"subtotalMinor\"::bigint = \"unitPriceMinor\"::bigint * \"quantity\"::bigint", name: "order_item_subtotal")

}

model OrderStatusHistory {
  id              Uuid                       @id @default(uuid())
  orderId         Uuid

  fromStatus      OrderStatus?
  toStatus        OrderStatus

  changedByUserId String?
  reason          VarChar(300)?

  createdAt       temporal.createdAtString()

  order           Order                      @relation(fields:[orderId], references:[id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model BakerySettings {
  id                        String                     @id @default("default")

  bakeryName                VarChar(120)
  phone                     VarChar(30)
  address                   VarChar(250)

  timezone                  VarChar(100)               @default("Europe/Belgrade")
  currencyCode              VarChar(3)                 @default("RSD")

  orderAcceptingEnabled     Boolean                    @default(true)
  minimumPreparationMinutes Int                        @default(30)
  maximumAdvanceDays        Int                        @default(7)
  pickupSlotMinutes         Int                        @default(15)

  notificationEmail         VarChar(254)?

  createdAt                 temporal.createdAtString()
  updatedAt                 temporal.updatedAtString()

  businessHours             BusinessHours[]
  @@check(expression: "\"minimumPreparationMinutes\" BETWEEN 0 AND 240 AND \"maximumAdvanceDays\" BETWEEN 0 AND 30 AND \"pickupSlotMinutes\" IN (5, 10, 15, 20, 30, 60)", name: "bakery_configuration_limits")

}

model BusinessHours {
  id               Uuid                       @id @default(uuid())

  bakerySettingsId String                     @default("default")
  weekday          Int
  openMinute       Int
  closeMinute      Int

  createdAt        temporal.createdAtString()
  updatedAt        temporal.updatedAtString()

  bakerySettings   BakerySettings             @relation(fields:[bakerySettingsId], references:[id], onDelete: Cascade)

  @@index([bakerySettingsId, weekday, openMinute])
  @@check(expression: "\"weekday\" BETWEEN 1 AND 7 AND \"openMinute\" >= 0 AND \"closeMinute\" <= 1440 AND \"openMinute\" < \"closeMinute\"", name: "business_hours_range")

}

model ActionRateLimitBucket {
  id            Uuid              @id @default(uuid())

  keyHash       String
  action        String

  windowStart   TimestamptzString
  windowSeconds Int
  count         Int               @default(0)
  expiresAt     TimestamptzString

  @@unique([keyHash, action, windowStart, windowSeconds])
  @@index([expiresAt])
  @@check(expression: "\"count\" >= 0 AND \"windowSeconds\" > 0", name: "rate_bucket_values")

}

enum UserRole {
  @@type("pg/text@1")

  STAFF
  ADMIN
}

model User {
  id            String                     @id
  name          String
  email         String                     @unique
  emailVerified Boolean                    @default(false)
  image         String?
  role          UserRole                   @default(STAFF)
  isActive      Boolean                    @default(true)
  createdAt     temporal.createdAtString()
  updatedAt     temporal.updatedAtString()

  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String                     @id
  expiresAt TimestamptzString
  token     String                     @unique
  createdAt temporal.createdAtString()
  updatedAt temporal.updatedAtString()
  ipAddress String?
  userAgent String?
  userId    String

  user      User                       @relation(fields:[userId], references:[id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String                     @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  TimestamptzString?
  refreshTokenExpiresAt TimestamptzString?
  scope                 String?
  password              String?
  createdAt             temporal.createdAtString()
  updatedAt             temporal.updatedAtString()

  user                  User                       @relation(fields:[userId], references:[id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String                     @id
  identifier String
  value      String
  expiresAt  TimestamptzString
  createdAt  temporal.createdAtString()
  updatedAt  temporal.updatedAtString()

  @@index([identifier])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

enum NotificationStatus {
  @@type("pg/text@1")
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

model OrderNotificationDelivery {
  id Uuid @id @default(uuid())
  orderId Uuid
  recipientType VarChar(16)
  status NotificationStatus @default(PENDING)
  attempts Int @default(0)
  lastErrorCode VarChar(80)?
  leaseUntil TimestamptzString?
  deliveredAt TimestamptzString?
  createdAt temporal.createdAtString()
  updatedAt temporal.updatedAtString()
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@unique([orderId, recipientType])
  @@index([status, updatedAt])
  @@check(expression: "attempts >= 0 AND attempts <= 5", name: "notification_attempts")
  @@check(expression: "\"recipientType\" IN ('customer', 'bakery')", name: "notification_recipient")
}
